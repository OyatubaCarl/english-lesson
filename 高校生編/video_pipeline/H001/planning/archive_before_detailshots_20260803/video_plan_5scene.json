  "captions": [
    {"start": 12.08, "end": 16.55, "en": "At dawn, I <k>stood</k> by the lake.", "ja": "夜明けに、私は湖のほとりに立っていた。"},
    {"start": 16.55, "end": 19.10, "en": "The water <k>lay</k> still.", "ja": "水面は静まり返っていた。"},
    {"start": 21.38, "end": 27.62, "en": "A gentle mist <k>drifted</k> on the surface.", "ja": "薄い霧が水面を漂っていた。"},
    {"start": 27.62, "end": 32.48, "en": "The world <k>breathed</k> quietly.", "ja": "世界は静かに呼吸していた。"},
    {"start": 32.48, "end": 39.64, "en": "The light gradually <k>appeared</k> in the distant sky.", "ja": "遠くの空に、光が徐々に現れた。"},
    {"start": 39.64, "end": 42.20, "en": "The sun <k>emerged</k>.", "ja": "太陽が姿を現した。"},
    {"start": 42.20, "end": 46.70, "en": "Its rays <k>spread</k> across the pure air.", "ja": "その光が澄んだ空気の中に広がった。"},
    {"start": 50.44, "end": 52.18, "en": "No one <k>spoke</k>.", "ja": "誰も口を開かなかった。"},
    {"start": 52.18, "end": 55.26, "en": "I <k>gazed</k> at the shore.", "ja": "私は岸辺を見つめた。"},
    {"start": 55.26, "end": 61.00, "en": "A narrow stream <k>flowed</k> near my feet.", "ja": "足元の近くを細い小川が流れていた。"},
    {"start": 61.00, "end": 64.99, "en": "The water <k>whispered</k> softly.", "ja": "水は静かにささやいていた。"},
    {"start": 64.99, "end": 68.98, "en": "Birds <k>sang</k> in distant trees.", "ja": "遠くの木々で鳥たちが歌っていた。"},
    {"start": 68.98, "end": 78.04, "en": "A fish <k>jumped</k>, and gentle ripples <k>ran</k> outward\\Nfrom the edge.", "ja": "一匹の魚が跳ね、穏やかな波紋が水際から外へ広がった。"},
    {"start": 78.04, "end": 84.52, "en": "From the depths of the forest, a faint presence <k>moved</k>.", "ja": "森の奥深くで、かすかな気配が動いた。"},
    {"start": 84.52, "end": 86.96, "en": "I <k>noticed</k> a deer.", "ja": "私は一頭の鹿に気づいた。"},
    {"start": 86.96, "end": 88.92, "en": "It <k>stood</k> still.", "ja": "それはじっと立っていた。"},
    {"start": 88.92, "end": 94.16, "en": "Then it <k>vanished</k> into the trees.", "ja": "そして木々の中へ消えた。"},
    {"start": 94.16, "end": 100.20, "en": "I simply <k>observed</k> the landscape in silence.", "ja": "私はただ、静けさの中でその風景を見つめていた。"},
    {"start": 101.16, "end": 105.34, "en": "Nothing <k>spoke</k>, yet everything <k>lived</k>.", "ja": "何も語らなかったが、すべてが生きていた。"},
    {"start": 106.16, "end": 108.64, "en": "The morning <k>continued</k>.", "ja": "朝は続いていた。"},
    {"start": 110.74, "end": 114.44, "en": "A new day <k>arose</k>.", "ja": "新しい一日が始まった。"},
    {"start": 116.90, "end": 120.08, "en": "I <k>remained</k> there.", "ja": "私はそこに残っていた。"},
    {"start": 121.68, "end": 124.48, "en": "Time <k>passed</k>.", "ja": "時が過ぎた。"}
  ]
