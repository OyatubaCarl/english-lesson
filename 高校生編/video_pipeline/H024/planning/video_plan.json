  "captions": [
    {"start": 0.78, "end": 7.9, "en": "My grandfather worked for many years as the keeper of a lighthouse in a seaside town.", "ja": ""},
    {"start": 9.28, "end": 12.92, "en": "That town was the place where he lived his whole life.", "ja": ""},
    {"start": 12.92, "end": 16.94, "en": "Every night he would climb the stairs of the tower.", "ja": ""},
    {"start": 19.0, "end": 26.72, "en": "He checked the lamp, wiped the windows, and when a storm approached, he worked through the whole night without sleep.", "ja": ""},
    {"start": 27.56, "end": 32.64, "en": "Every summer I visited his house and looked up at the light.", "ja": ""},
    {"start": 32.64, "end": 39.62, "en": "The moment when the lighthouse began to glow was the time when I most wished to be there.", "ja": ""},
    {"start": 41.7, "end": 48.0, "en": "Once he revealed to me the reason why he had continued this work.", "ja": ""},
    {"start": 48.0, "end": 58.48, "en": "So that ships that come back from across the sea can enter the harbor safely, he said.", "ja": ""},
    {"start": 58.48, "end": 64.28, "en": "I often think of the way he guided sailors.", "ja": ""},
    {"start": 64.28, "end": 72.12, "en": "Between my grandfather and the lighthouse was a long bond that needed no words.", "ja": ""},
    {"start": 72.12, "end": 80.24, "en": "I could never imagine how many sailors his light had guided on stormy nights.", "ja": ""}
  ]
}
