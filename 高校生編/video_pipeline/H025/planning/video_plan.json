  "captions": [
    {"start": 7.34, "end": 10.86, "en": "A small concert was held in the town hall.", "ja": ""},
    {"start": 11.76, "end": 16.32, "en": "Whoever came could enter with free admission.", "ja": ""},
    {"start": 16.32, "end": 21.14, "en": "Whoever performed was warmly welcomed by the audience.", "ja": ""},
    {"start": 21.14, "end": 26.3, "en": "The first to perform was a girl of ten, holding a violin.", "ja": ""},
    {"start": 28.1, "end": 33.86, "en": "When she finished, however softly she played, every note reached the listeners in the room.", "ja": ""},
    {"start": 33.86, "end": 37.02, "en": "Applause rose several times.", "ja": ""},
    {"start": 38.68, "end": 44.7, "en": "Whichever movement she played, her tone was pure.", "ja": ""},
    {"start": 46.44, "end": 51.68, "en": "Whoever listened could not help but admire the purity of her sound.", "ja": ""},
    {"start": 51.68, "end": 62.98, "en": "That evening, the hall was more peaceful than I had ever seen, and people exchanged smile after smile with one another.", "ja": ""},
    {"start": 66.4, "end": 78.26, "en": "This kind of place, whenever it exists, is a small community tradition that I want to treasure.", "ja": ""}
