  "captions": [
    {"start": 10.24, "end": 18.0, "en": "If I were a bird, I would fly freely wherever I wished.", "ja": ""},
    {"start": 18.0, "end": 32.92, "en": "In the morning I would pass through the forest, at noon I would cross the valley, and at night I would sleep beside the stars.", "ja": ""},
    {"start": 37.48, "end": 42.52, "en": "If I had wings, I would soar above the clouds.", "ja": ""},
    {"start": 42.52, "end": 49.34, "en": "I would not feel constrained by the distance to faraway cities.", "ja": ""},
    {"start": 49.34, "end": 58.5, "en": "If I were not bound to the ground, I would surely travel wherever the wind carried me.", "ja": ""},
    {"start": 58.5, "end": 62.0, "en": "Yet, now I stand on the Earth.", "ja": ""},
    {"start": 64.96, "end": 68.36, "en": "I am not a bird.", "ja": ""},
    {"start": 68.36, "end": 71.08, "en": "I can only imagine.", "ja": ""},
    {"start": 71.08, "end": 76.44, "en": "Still, to imagine is a small form of freedom.", "ja": ""},
    {"start": 76.44, "end": 87.72, "en": "Looking up at the evening sky, I think: if I were a bird, how deeply would I admire this sky?", "ja": ""},
    {"start": 90.86, "end": 100.5, "en": "Standing on the ground, I still look up at the same sky.", "ja": ""},
    {"start": 103.36, "end": 107.52, "en": "Imagination embraces me instead.", "ja": ""}
  ]
}
