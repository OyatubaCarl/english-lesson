  "captions": [
    {"start": 11.12, "end": 17.68, "en": "If I had sent the letter that day, everything might have been different.", "ja": ""},
    {"start": 17.68, "end": 22.78, "en": "My childhood friend had moved to a distant town.", "ja": ""},
    {"start": 24.02, "end": 30.38, "en": "All I had to do was write a single word of thanks.", "ja": ""},
    {"start": 30.38, "end": 35.46, "en": "A single letter would have been enough.", "ja": ""},
    {"start": 36.76, "end": 48.44, "en": "If I had had a little more courage at the time, the letter would have reached her, and she might have remembered me for longer.", "ja": ""},
    {"start": 49.78, "end": 53.66, "en": "But I did not put it into words.", "ja": ""},
    {"start": 53.66, "end": 60.38, "en": "I hid my words away, treasuring them too carefully.", "ja": ""},
    {"start": 62.36, "end": 69.0, "en": "When I realized it, I no longer knew the address of her town.", "ja": ""},
    {"start": 69.0, "end": 80.96, "en": "If I had written that one letter, I might have been corresponding with her to this day.", "ja": ""},
    {"start": 80.96, "end": 91.94, "en": "Long after, when I heard the news of her marriage, I tasted that small regret once more.", "ja": ""},
    {"start": 91.94, "end": 105.14, "en": "I learned that a life can turn on the courage it takes to send a single letter.", "ja": ""}
  ]
