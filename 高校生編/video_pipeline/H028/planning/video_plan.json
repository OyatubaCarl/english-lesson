  "captions": [
    {"start": 11.54, "end": 15.28, "en": "The discovery of penicillin began with an accident.", "ja": ""},
    {"start": 15.94, "end": 22.84, "en": "In 1928, in a laboratory in London, a scientist returned from his vacation.", "ja": ""},
    {"start": 23.84, "end": 30.12, "en": "Alexander Fleming noticed that a strange mold had grown on one of the dishes left on his bench.", "ja": ""},
    {"start": 32.14, "end": 35.78, "en": "Around the mold, the bacteria had vanished.", "ja": ""},
    {"start": 36.2, "end": 42.58, "en": "How much the world would have lost if Fleming had missed that small observation!", "ja": ""},
    {"start": 43.7, "end": 55.1, "en": "If he had not noticed that mold, many infections might not have been treated, and countless lives might have been lost because of wounds on the battlefield.", "ja": ""},
    {"start": 55.46, "end": 60.32, "en": "That one dish helped open the age of antibiotics.", "ja": ""},
    {"start": 61.8, "end": 71.3, "en": "Fleming's careful observation, followed by the work of many other scientists, eventually helped save millions of lives.", "ja": ""},
    {"start": 71.6, "end": 83.02, "en": "If that chance observation had never been made, the history of science would have been utterly different.", "ja": ""}
  ]
