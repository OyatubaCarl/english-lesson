  "captions": [
    {"start": 12.28, "end": 17.7, "en": "What is the oldest tree in the world?", "ja": ""},
    {"start": 18.22, "end": 21.98, "en": "Many people think of a great oak.", "ja": ""},
    {"start": 23.0, "end": 33.3, "en": "But there is an ancient tree far older than any oak.", "ja": ""},
    {"start": 34.76, "end": 45.92, "en": "High in the mountains of California, a bristlecone pine has survived for over four thousand years.", "ja": ""},
    {"start": 45.92, "end": 50.32, "en": "It is one of the oldest living trees on Earth.", "ja": ""},
    {"start": 50.32, "end": 56.58, "en": "The bristlecone pine grows slowly.", "ja": ""},
    {"start": 58.82, "end": 64.52, "en": "Compared with other pines, it may add only a few millimeters each year.", "ja": ""},
    {"start": 66.12, "end": 68.98, "en": "But it is far stronger.", "ja": ""},
    {"start": 70.2, "end": 79.78, "en": "In the high mountains, the air is thin, the wind is cold, and the soil is poor.", "ja": ""},
    {"start": 79.78, "end": 90.9, "en": "Yet such a harsh environment is what has enabled the long life of this tree.", "ja": ""},
    {"start": 92.5, "end": 102.2, "en": "Scientists measure the age of these trees from growth rings within the wood.", "ja": ""},
    {"start": 106.76, "end": 116.58, "en": "One has been found to be more than four thousand eight hundred years old.", "ja": ""},
    {"start": 116.58, "end": 127.18, "en": "We cannot help admiring a tree that is older than many civilizations.", "ja": ""},
    {"start": 127.18, "end": 139.28, "en": "It is among the most remarkable living beings, carrying silence and strength together.", "ja": ""}
  ]
