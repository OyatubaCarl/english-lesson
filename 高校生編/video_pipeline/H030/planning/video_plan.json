    {"start": 12.82, "end": 21.08, "en": "Had it not been for Kennedy's speech of 1961, such a challenge to technology might never have begun.", "ja": ""},
    {"start": 24.22, "end": 29.26, "en": "The moment Armstrong set foot on the Moon, people all over the world watched the scene.", "ja": ""},
