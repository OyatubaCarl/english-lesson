  "captions": [
    {"start": 1.66, "end": 5.74, "en": "Marie Curie was born in Poland and later moved to Paris.", "ja": ""},
    {"start": 6.92, "end": 12.04, "en": "Her name, Marie Curie, is one of the most famous physicists in the history of science.", "ja": ""},
    {"start": 12.98, "end": 18.74, "en": "Her passion, namely her devotion to science, was extraordinary.", "ja": ""},
    {"start": 21.22, "end": 25.76, "en": "Together with her husband Pierre, she devoted much of her life to research.", "ja": ""},
    {"start": 25.76, "end": 32.1, "en": "Their goal, to isolate and study the new element radium, meant years of endless difficulty.", "ja": ""},
    {"start": 33.76, "end": 38.56, "en": "The work in the laboratory involved the work of turning many tons of mineral into powder.", "ja": ""},
    {"start": 39.02, "end": 43.84, "en": "The couple continued despite the risk, exposing themselves to radiation.", "ja": ""},
    {"start": 44.84, "end": 52.48, "en": "Her achievement of winning two Nobel Prizes could not have come without her pure love of study, namely her passion.", "ja": ""},
    {"start": 53.54, "end": 61.26, "en": "As a woman, a mother, and a scientist, she opened a path for later generations.", "ja": ""}
