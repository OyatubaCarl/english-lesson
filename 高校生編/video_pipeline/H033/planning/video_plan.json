  "captions": [
    {"start": 5.58, "end": 17.666, "en": "Isaac Newton, in his later years, described himself as someone who still knew very little compared with the vast unknown.", "ja": ""},
    {"start": 17.666, "end": 23.94, "en": "Few people have ever given humanity such great knowledge.", "ja": ""},
    {"start": 26.4, "end": 34.443, "en": "The law of gravity, the three laws of motion, the development of calculus.", "ja": ""},
    {"start": 34.443, "end": 43.3, "en": "Before Newton, no single theory explained both falling objects and planetary orbits.", "ja": ""},
    {"start": 43.3, "end": 50.34, "en": "His mathematics itself rebuilt the very language of science.", "ja": ""},
    {"start": 50.34, "end": 58.04, "en": "Yet he never allowed himself to become proud.", "ja": ""},
    {"start": 58.04, "end": 68.285, "en": "He compared himself to a child on the seashore, finding only a few interesting stones.", "ja": ""},
    {"start": 68.285, "end": 78.18, "en": "Before him, he said, the vast ocean of truth remained largely unexplored.", "ja": ""},
    {"start": 81.16, "end": 91.02, "en": "Newton's humility teaches us that however much one knows, it is never enough.", "ja": ""},
    {"start": 91.02, "end": 101.54, "en": "Theory may extend far, but the ocean of knowledge is deeper still.", "ja": ""}
  ]
