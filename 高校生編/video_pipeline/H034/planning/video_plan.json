  "captions": [
    {"start": 10.92, "end": 21.14, "en": "Antoni Gaudí, from the end of the nineteenth century through the early twentieth, was the architect who created a unique architectural language in Barcelona, Spain.", "ja": ""},
    {"start": 22.08, "end": 29.712, "en": "His most famous work is the basilica known as the Sagrada Família.", "ja": ""},
    {"start": 30.4, "end": 37.04, "en": "For more than a hundred years, its construction has continued, with interruptions.", "ja": ""},
    {"start": 37.38, "end": 40.06, "en": "It is an unfinished masterpiece.", "ja": ""},
    {"start": 41.059, "end": 44.42, "en": "Gaudí drew inspiration for his designs in nature.", "ja": ""},
    {"start": 44.64, "end": 46.652, "en": "Trees, mountains, shells, bones, waves.", "ja": ""},
    {"start": 46.652, "end": 51.48, "en": "Every column, every curve, was designed from a form found in nature.", "ja": ""},
    {"start": 52.56, "end": 56.96, "en": "He described nature as his great teacher.", "ja": ""},
    {"start": 56.96, "end": 62.7, "en": "For him, nature itself was a form of architecture.", "ja": ""},
    {"start": 62.7, "end": 72.7, "en": "In 1926, Gaudí was struck by a tram and died from his injuries several days later.", "ja": ""},
    {"start": 73.7, "end": 83.84, "en": "The cathedral, however, is still being built, century after century, through donations and support from visitors around the world.", "ja": ""},
    {"start": 83.84, "end": 92.62, "en": "Perhaps its unfinished state has itself become part of the building's history.", "ja": ""}
  ]
}
