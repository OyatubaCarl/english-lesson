  "captions": [
    {
      "start": 0.0,
      "end": 8.84,
      "en": "A modern corporation spends a great deal on advertising in order to make its brand known to as many people as possible.",
      "ja": ""
    },
    {
      "start": 9.72,
      "end": 19.6,
      "en": "Through media such as television, newspapers, magazines, and the internet, countless advertisements reach us every day.",
      "ja": ""
    },
    {
      "start": 19.6,
      "end": 28.38,
      "en": "The purpose of an advertisement is to attract the attention of the consumer and persuade consumers to make a purchase.",
      "ja": ""
    },
    {
      "start": 28.38,
      "end": 38.22,
      "en": "The image of a brand, just as much as the quality of a product, has influence over our choice.",
      "ja": ""
    },
    {
      "start": 38.22,
      "end": 48.32,
      "en": "Since the appearance of social media, consumers themselves have been able to broadcast their opinions to the world.",
      "ja": ""
    },
    {
      "start": 48.32,
      "end": 57.8,
      "en": "An opinion against a certain brand can spread across the internet within hours, and the image of a corporation may shift overnight.",
      "ja": ""
    },
    {
      "start": 59.02,
      "end": 68.08,
      "en": "Governments, too, have established regulations to protect consumers from misleading advertising.",
      "ja": ""
    },
    {
      "start": 68.84,
      "end": 77.8,
      "en": "For example, products related to health may not make any claim without solid evidence.",
      "ja": ""
    },
    {
      "start": 78.86,
      "end": 90.42,
      "en": "Today's consumption society binds corporations, consumers, and the state in a triangular relationship in which each watches the others.",
      "ja": ""
    },
    {
      "start": 90.9,
      "end": 98.0,
      "en": "We ourselves are required to keep a critical eye on what we are shown.",
      "ja": ""
    }
  ]
}
