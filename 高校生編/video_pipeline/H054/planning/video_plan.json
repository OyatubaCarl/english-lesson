  "captions": [
    {
      "start": 0.98,
      "end": 9.34,
      "en": "The ancient Olympics in Greece were a festival of peace, even halting wars during the games.",
      "ja": ""
    },
    {
      "start": 10.0,
      "end": 12.8,
      "en": "The modern Olympics inherit that spirit.",
      "ja": ""
    },
    {
      "start": 12.8,
      "end": 19.46,
      "en": "Athletes from across the world, after long years of training, step into competition.",
      "ja": ""
    },
    {
      "start": 20.0,
      "end": 24.78,
      "en": "Their discipline and dedication are more precious than anything else.",
      "ja": ""
    },
    {
      "start": 24.78,
      "end": 27.8,
      "en": "Victory is not everything.",
      "ja": ""
    },
    {
      "start": 28.68,
      "end": 36.92,
      "en": "Sportsmanship, the spirit of respecting an opponent and following the rules, is the true meaning of sport.",
      "ja": ""
    },
    {
      "start": 37.42,
      "end": 42.66,
      "en": "In recent years, the doping problem has shaken competition around the world.",
      "ja": ""
    },
    {
      "start": 42.96,
      "end": 50.16,
      "en": "Athletes who use banned drugs lose their medals and are removed from their sport.",
      "ja": ""
    },
    {
      "start": 50.16,
      "end": 55.3,
      "en": "To preserve the principle of fair play, strict testing is essential.",
      "ja": ""
    },
    {
      "start": 55.3,
      "end": 63.42,
      "en": "Winning teams gather enthusiastic fans, and losing teams receive quiet applause.",
      "ja": ""
    },
    {
      "start": 63.42,
      "end": 71.16,
      "en": "To accept defeat and turn toward the next challenge — this is the true beauty of sport.",
      "ja": ""
    },
    {
      "start": 71.16,
      "end": 76.84,
      "en": "Children in front of the television look up to these athletes.",
      "ja": ""
    },
    {
      "start": 77.5,
      "end": 84.28,
      "en": "As role models, they pass on to a younger generation the message that effort can bear fruit.",
      "ja": ""
    }
  ]
