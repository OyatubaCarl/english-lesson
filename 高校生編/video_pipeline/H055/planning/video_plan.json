  "captions": [
    {
      "start": 4.74,
      "end": 10.88,
      "en": "Japan is one of the most rapidly aging societies in the world.",
      "ja": ""
    },
    {
      "start": 10.88,
      "end": 19.02,
      "en": "The population aged 65 and above already makes up over 28 percent of the whole.",
      "ja": ""
    },
    {
      "start": 21.0,
      "end": 30.5,
      "en": "A long life is something to be celebrated, yet our society faces new challenges.",
      "ja": ""
    },
    {
      "start": 31.22,
      "end": 39.42,
      "en": "The workforce is declining, and the pension system has become harder to sustain.",
      "ja": ""
    },
    {
      "start": 39.42,
      "end": 46.44,
      "en": "Medical costs for older people increase each year, putting pressure on the national budget.",
      "ja": ""
    },
    {
      "start": 46.44,
      "end": 54.34,
      "en": "How to sustain welfare is a common challenge for every developed country.",
      "ja": ""
    },
    {
      "start": 54.34,
      "end": 59.94,
      "en": "The form of the family has also changed.",
      "ja": ""
    },
    {
      "start": 59.94,
      "end": 71.06,
      "en": "More elderly now live apart from their children and grandchildren, and a new problem has appeared: loneliness.",
      "ja": ""
    },
    {
      "start": 71.06,
      "end": 82.9,
      "en": "Local communities have begun various efforts to support elderly people who live alone.",
      "ja": ""
    },
    {
      "start": 84.78,
      "end": 96.88,
      "en": "Volunteers visit them regularly, and care facilities are trying to make up for the shortage of staff with new technology.",
      "ja": ""
    },
    {
      "start": 97.9,
      "end": 107.1,
      "en": "The mutual support between generations will be the foundation of our future society.",
      "ja": ""
    },
    {
      "start": 108.4,
      "end": 114.18,
      "en": "The young and the old, each respecting and supporting the other.",
      "ja": ""
    },
    {
      "start": 114.9,
      "end": 120.26,
      "en": "This is what creates the true richness of a long-lived society.",
      "ja": ""
    }
  ]
