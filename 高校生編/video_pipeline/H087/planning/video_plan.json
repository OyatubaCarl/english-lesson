  "captions": [
    {
      "start": 0.96,
      "end": 9.882,
      "en": "One morning, the alarm rang, but I was not eager to get up — I was simply bored.",
      "ja": "ある朝、目覚ましが鳴っても僕は起きる気になれず、ただ bored だったのです。"
    },
    {
      "start": 10.202,
      "end": 15.236,
      "en": "I had been annoyed by the same routine repeating itself every day.",
      "ja": "毎日同じ繰り返しが続くことに、僕は annoyed でした。"
    },
    {
      "start": 15.236,
      "end": 19.663,
      "en": "I tried to make coffee, but the beans had run out.",
      "ja": "コーヒーをいれようとしましたが、豆を切らしていました。"
    },
    {
      "start": 20.072,
      "end": 24.919,
      "en": "I walked to the neighborhood cafe and ordered coffee from a clerk I knew by sight.",
      "ja": "僕は近所のカフェまで歩き、顔見知りの clerk にコーヒーを注文しました。"
    },
    {
      "start": 24.919,
      "end": 29.205,
      "en": "I had no cash, so I paid by card.",
      "ja": "cash がなかったので、カードで支払いました。"
    },
    {
      "start": 29.885,
      "end": 34.966,
      "en": "On the way back, I met the elderly lady next door.",
      "ja": "帰り道、隣に住む年配の女性に会いました。"
    },
    {
      "start": 35.266,
      "end": 40.027,
      "en": "Yesterday I lost my precious ring in the garden, she said.",
      "ja": "『昨日、庭で大切な指輪をなくしてしまったの』と彼女は言いました。"
    },
    {
      "start": 40.027,
      "end": 45.508,
      "en": "An insect bit my hand, and when I waved it, the ring flew off.",
      "ja": "『虫に手を刺されて振り払った拍子に、指輪が飛んでいったの』"
    },
    {
      "start": 45.544,
      "end": 47.96,
      "en": "I did not mind helping.",
      "ja": "僕は手伝うことを嫌だとは思いませんでした。"
    },
    {
      "start": 48.26,
      "end": 50.929,
      "en": "I was glad to help.",
      "ja": "むしろ、手伝えてうれしかったのです。"
    },
    {
      "start": 51.629,
      "end": 60.551,
      "en": "After digging for fifteen minutes with a shovel, a golden ring appeared from the soil.",
      "ja": "シャベルで15分ほど digging すると、土の中から金色の指輪が現れました。"
    },
    {
      "start": 60.871,
      "end": 64.832,
      "en": "She laughed and said, What good luck you bring, young man.",
      "ja": "彼女は笑って、『まあ、若い方。あなたは幸運を運んでくれるのね』と言いました。"
    },
    {
      "start": 64.832,
      "end": 68.112,
      "en": "Back at home, a friend called.",
      "ja": "家に戻ると、友人から電話がありました。"
    },
    {
      "start": 68.592,
      "end": 70.553,
      "en": "Will you come camping next week?",
      "ja": "『来週、キャンプに来ない？』"
    },
    {
      "start": 70.553,
      "end": 71.194,
      "en": "he asked.",
      "ja": "と、彼は尋ねました。"
    },
    {
      "start": 71.194,
      "end": 74.232,
      "en": "I accepted the invitation at once.",
      "ja": "僕はすぐに、その誘いを受けました。"
    },
    {
      "start": 74.232,
      "end": 77.514,
      "en": "I would need to borrow a tent.",
      "ja": "テントを borrow する必要がありそうでした。"
    },
    {
      "start": 78.345,
      "end": 86.895,
      "en": "A day I had thought would be boring turned out, by the end, to be a good day blessed by circumstance.",
      "ja": "boring だと思っていた一日は、最後には思いがけない circumstance に恵まれた良い一日になりました。"
    },
    {
      "start": 87.896,
      "end": 96.917,
      "en": "In the ordinary flow of daily life, small events and conversation are always waiting.",
      "ja": "何気ない日常の流れの中で、小さな出来事や conversation がいつも待っています。"
    },
    {
      "start": 97.518,
      "end": 106.639,
      "en": "Perhaps every day is, after all, a little more comfortable than we think.",
      "ja": "結局、毎日は僕たちが思うより少し comfortable なのかもしれません。"
    }
  ]
}
