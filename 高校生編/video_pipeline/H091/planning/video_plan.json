  "captions": [
    {
      "start": 11.265,
      "end": 25.263,
      "en": "The week after I graduated from university, I set off alone for southern Europe.",
      "ja": "大学を graduated 翌週、私は一人で南ヨーロッパへ旅立ちました。"
    },
    {
      "start": 25.638,
      "end": 32.424,
      "en": "A cheap airline ticket and a worn-out backpack were all I had.",
      "ja": "私が持っていたのは格安航空券とボロボロのバックパックだけでした。"
    },
    {
      "start": 32.759,
      "end": 44.326,
      "en": "The old quarter of Barcelona was a maze of bare stone walls and narrow lanes.",
      "ja": "バルセロナの旧市街は、 bare 石の壁と狭い路地の迷路でした。"
    },
    {
      "start": 45.854,
      "end": 49.646,
      "en": "My footsteps echoed against the walls.",
      "ja": "私の足音が壁に響きました。"
    },
    {
      "start": 49.946,
      "end": 56.287,
      "en": "At every turn, a small craft shop or a folk music bar appeared.",
      "ja": "至る所に小さな craft 品店や民族音楽バーが現れました。"
    },
    {
      "start": 56.307,
      "end": 63.628,
      "en": "Down at the harbor, a dozen fishing boats were lined up.",
      "ja": "港には十数隻の漁船が並んでいた。"
    },
    {
      "start": 66.249,
      "end": 76.29,
      "en": "In the market, the scent of fresh bread and the aroma of rich spices drifted in the air and stirred my appetite.",
      "ja": "市場では焼きたてのパンの香りと濃厚なスパイスの香りが漂い、 appetite をそそられました。"
    },
    {
      "start": 76.59,
      "end": 85.051,
      "en": "I took a train south and stayed at an inn in a whitewashed village.",
      "ja": "電車に乗って南下し、白壁の村の宿に泊まった。"
    },
    {
      "start": 86.169,
      "end": 94.692,
      "en": "The owners were a generous elderly couple who served me dinner.",
      "ja": "オーナーは generous 老夫婦で、夕食を提供してくれました。"
    },
    {
      "start": 95.652,
      "end": 101.873,
      "en": "The furniture was old but well kept.",
      "ja": "furniture は古いですが、手入れが行き届いていました。"
    },
    {
      "start": 103.493,
      "end": 113.934,
      "en": "On the last morning, I leaned on the balcony and looked out at the sea.",
      "ja": "最後の朝、私はバルコニーに寄りかかって海を眺めました。"
    },
    {
      "start": 116.092,
      "end": 118.795,
      "en": "The wind blew gently.",
      "ja": "風が優しく吹いていました。"
    },
    {
      "start": 119.995,
      "end": 129.185,
      "en": "This time of leisure was exactly what I had been seeking on the journey.",
      "ja": "この leisure の時間こそ、私が旅の途中で求めていたものでした。"
    },
    {
      "start": 129.485,
      "end": 133.257,
      "en": "The trip taught me something.",
      "ja": "この旅は私に何かを教えてくれました。"
    },
    {
      "start": 134.225,
      "end": 145.158,
      "en": "The world is far more friendly, and far broader, than I had ever imagined.",
      "ja": "世界は私が想像していたよりもはるかにフレンドリーで、はるかに広いです。"
    }
  ]
}
